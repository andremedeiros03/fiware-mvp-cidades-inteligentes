              }
            ],
            "url": {
              "raw": "http://localhost:1026/ngsi-ld/v1/entityOperations/create",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "1026",
              "path": [
                "ngsi-ld",
                "v1",
                "entityOperations",
                "create"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"id\": \"urn:ngsi-ld:RoadSegment:avenida-principal-a\",\n    \"type\": \"RoadSegment\",\n    \"name\": {\n      \"type\": \"Property\",\n      \"value\": \"Avenida Principal - Trecho A (Norte)\"\n    },\n    \"refRoad\": {\n      \"type\": \"Relationship\",\n      \"object\": \"urn:ngsi-ld:Road:avenida-principal\"\n    },\n    \"startPoint\": {\n      \"type\": \"GeoProperty\",\n      \"value\": {\n        \"type\": \"Point\",\n        \"coordinates\": [\n          -46.65,\n          -10.1\n        ]\n      }\n    },\n    \"endPoint\": {\n      \"type\": \"GeoProperty\",\n      \"value\": {\n        \"type\": \"Point\",\n        \"coordinates\": [\n          -46.65,\n          -10.109\n        ]\n      }\n    },\n    \"location\": {\n      \"type\": \"GeoProperty\",\n      \"value\": {\n        \"type\": \"LineString\",\n        \"coordinates\": [\n          [\n            -46.65,\n            -10.1\n          ],\n          [\n            -46.65,\n            -10.109\n          ]\n        ]\n      }\n    },\n    \"allowedVehicleType\": {\n      \"type\": \"Property\",\n      \"value\": [\n        \"car\",\n        \"bus\",\n        \"motorcycle\",\n        \"lorry\"\n      ]\n    },\n    \"totalLaneNumber\": {\n      \"type\": \"Property\",\n      \"value\": 3\n    },\n    \"maximumAllowedSpeed\": {\n      \"type\": \"Property\",\n      \"value\": 60,\n      \"unitCode\": \"KMH\"\n    },\n    \"length\": {\n      \"type\": \"Property\",\n      \"value\": 1.0,\n      \"unitCode\": \"KMT\"\n    }\n  },\n  {\n    \"id\": \"urn:ngsi-ld:RoadSegment:avenida-principal-b\",\n    \"type\": \"RoadSegment\",\n    \"name\": {\n      \"type\": \"Property\",\n      \"value\": \"Avenida Principal - Trecho B (Sul)\"\n    },\n    \"refRoad\": {\n      \"type\": \"Relationship\",\n      \"object\": \"urn:ngsi-ld:Road:avenida-principal\"\n    },\n    \"startPoint\": {\n      \"type\": \"GeoProperty\",\n      \"value\": {\n        \"type\": \"Point\",\n        \"coordinates\": [\n          -46.65,\n          -10.109\n        ]\n      }\n    },\n    \"endPoint\": {\n      \"type\": \"GeoProperty\",\n      \"value\": {\n        \"type\": \"Point\",\n        \"coordinates\": [\n          -46.65,\n          -10.117\n        ]\n      }\n    },\n    \"location\": {\n      \"type\": \"GeoProperty\",\n      \"value\": {\n        \"type\": \"LineString\",\n        \"coordinates\": [\n          [\n            -46.65,\n            -10.109\n          ],\n          [\n            -46.65,\n            -10.117\n          ]\n        ]\n      }\n    },\n    \"allowedVehicleType\": {\n      \"type\": \"Property\",\n      \"value\": [\n        \"car\",\n        \"bus\",\n        \"motorcycle\",\n        \"lorry\"\n      ]\n    },\n    \"totalLaneNumber\": {\n      \"type\": \"Property\",\n      \"value\": 2\n    },\n    \"maximumAllowedSpeed\": {\n      \"type\": \"Property\",\n      \"value\": 50,\n      \"unitCode\": \"KMH\"\n    },\n    \"length\": {\n      \"type\": \"Property\",\n      \"value\": 0.9,\n      \"unitCode\": \"KMT\"\n    }\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
